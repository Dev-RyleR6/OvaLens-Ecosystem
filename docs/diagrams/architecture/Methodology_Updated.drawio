          <mxGeometry height="140" width="520" x="165" y="640" as="geometry" />
        </mxCell>
        <mxCell id="P4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;PHASE 4: HARDWARE &amp; SOFTWARE PROTOTYPING&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(DSRM: Design &amp; Development)&lt;/i&gt;&lt;hr size=&quot;1&quot; color=&quot;#cccccc&quot; style=&quot;margin-top:8px; margin-bottom:8px;&quot; /&gt;&lt;ul style=&quot;margin-top:0px; margin-bottom:0px; padding-left:25px;&quot;&gt;&lt;li&gt;&lt;b&gt;Hardware:&lt;/b&gt; Conveyor, Cradles, Chamber, LED/Cam, Servo&lt;/li&gt;&lt;li&gt;&lt;b&gt;Software:&lt;/b&gt; Raspberry Pi App, Web Dashboard&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
