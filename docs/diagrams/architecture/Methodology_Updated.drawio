        <mxCell id="P1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;PHASE 1: PLANNING &amp; REQUIREMENTS&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(DSRM: Problem Identification &amp; Objectives Definition)&lt;/i&gt;&lt;hr size=&quot;1&quot; color=&quot;#cccccc&quot; style=&quot;margin-top:8px; margin-bottom:8px;&quot; /&gt;&lt;ul style=&quot;margin-top:0px; margin-bottom:0px; padding-left:25px;&quot;&gt;&lt;li&gt;Define System Requirements&lt;/li&gt;&lt;li&gt;Design System Architecture&lt;/li&gt;&lt;li&gt;Identify System Components&lt;/li&gt;&lt;li&gt;Establish Evaluation Criteria&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="520" x="165" y="240" as="geometry" />
        </mxCell>
        <mxCell id="P2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;" value="&lt;div style=&quot;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;PHASE 2: DATA COLLECTION &amp; PREPARATION&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#cccccc&quot; style=&quot;margin-top:8px; margin-bottom:8px;&quot; /&gt;&lt;ul style=&quot;margin-top:0px; margin-bottom:5px; padding-left:25px;&quot;&gt;&lt;li&gt;Capture Duck Egg Images&lt;/li&gt;&lt;li&gt;Label and Annotate Images&lt;/li&gt;&lt;li&gt;Preprocess &amp; Organize Dataset (70/15/15 Split)&lt;/li&gt;&lt;/ul&gt;&lt;b style=&quot;padding-left:5px;&quot;&gt;Output:&lt;/b&gt; 3,000+ Annotated Images&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="520" x="165" y="420" as="geometry" />
        </mxCell>
        <mxCell id="AGILE_BOX" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FAFAFA;strokeColor=#333333;verticalAlign=top;spacingTop=10;strokeWidth=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;AGILE DEVELOPMENT CYCLE (Beck et al., 2001)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Incremental Development, Iterative Testing, and Continuous Refinement&lt;/i&gt;" vertex="1">
