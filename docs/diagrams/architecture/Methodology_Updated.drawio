        <mxCell id="DSRM" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;OVERARCHING FRAMEWORK: DESIGN SCIENCE RESEARCH METHODOLOGY (DSRM)&lt;/b&gt;&lt;br/&gt;Peffers et al. (2007)&lt;br/&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;1. Problem Identification | 2. Objectives Definition | 3. Design and Development&lt;br/&gt;4. Demonstration | 5. Evaluation | 6. Communication&lt;/div&gt;" vertex="1">
